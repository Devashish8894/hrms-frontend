import React, { useEffect, useState } from 'react';
import Chart from 'react-apexcharts';

// const API_BASE = import.meta.env.VITE_API_URL || 'http://localhost';
const API_BASE = 'http://localhost:5002';

const DEFAULT_EMPLOYEE = {
  firstName: '',
  lastName: '',
  email: '',
  password: '',
  roleKey: 'SOFTWARE_ENGINEER',
  department: 'Engineering',
  designation: 'Developer',
};

const ADMIN_ROLES = ['admin', 'org_admin', 'super_admin'];

export default function App() {
  // ============================================================
  // AUTHENTICATION STATE
  // ============================================================

  const [currentUser, setCurrentUser] = useState(() => {
    try {
      const saved = localStorage.getItem('hrms_user');
      return saved ? JSON.parse(saved) : null;
    } catch (error) {
      console.error('Failed to read logged-in user:', error);
      return null;
    }
  });

  const [loginEmail, setLoginEmail] = useState('');
  const [loginPassword, setLoginPassword] = useState('');
  const [loginError, setLoginError] = useState('');
  const [loadingAuth, setLoadingAuth] = useState(false);

  // ============================================================
  // ADMIN EMPLOYEE DIRECTORY
  // ============================================================

  const [employees, setEmployees] = useState([]);
  const [loadingEmployees, setLoadingEmployees] = useState(false);
  const [employeeError, setEmployeeError] = useState('');

  const [showModal, setShowModal] = useState(false);

  const [newEmp, setNewEmp] = useState(DEFAULT_EMPLOYEE);

  const [creatingEmployee, setCreatingEmployee] = useState(false);

  // ============================================================
  // EMPLOYEE ATTENDANCE
  // ============================================================

  const [attendanceStatus, setAttendanceStatus] =
    useState('Checked Out');

  const [checkInTime, setCheckInTime] = useState('--:--');

  const [checkOutTime, setCheckOutTime] = useState('--:--');

  // ============================================================
  // HELPER
  // ============================================================

  const isAdmin =
    currentUser &&
    ADMIN_ROLES.includes(currentUser.role);

  // ============================================================
  // CHART CONFIGURATION
  // ============================================================

  const chartOptions = {
    chart: {
      type: 'bar',
      toolbar: {
        show: false,
      },
    },

    plotOptions: {
      bar: {
        borderRadius: 6,
        columnWidth: '45%',
      },
    },

    xaxis: {
      categories: [
        'Mon',
        'Tue',
        'Wed',
        'Thu',
        'Fri',
        'Sat',
      ],
    },

    dataLabels: {
      enabled: false,
    },

    grid: {
      borderColor: '#e9ecef',
    },

    tooltip: {
      y: {
        formatter: (value) => `${value} hours`,
      },
    },
  };

  const chartSeries = [
    {
      name: 'Hours Worked',
      data: [8.5, 8.2, 8.8, 8.7, 8.0, 4.0],
    },
  ];

  // ============================================================
  // FETCH EMPLOYEES
  // ============================================================

  const fetchEmployees = async () => {
    if (!isAdmin) {
      return;
    }

    setLoadingEmployees(true);
    setEmployeeError('');

    try {
      const res = await fetch(
        `${API_BASE}/api/admin/employees`
      );

      const data = await res.json();

      if (!res.ok) {
        throw new Error(
          data.message || 'Failed to fetch employees'
        );
      }

      setEmployees(
        Array.isArray(data)
          ? data
          : data.employees || []
      );
    } catch (error) {
      console.error(
        'Error fetching employees:',
        error
      );

      setEmployeeError(
        error.message || 'Unable to load employees'
      );
    } finally {
      setLoadingEmployees(false);
    }
  };

  // ============================================================
  // LOAD EMPLOYEES WHEN ADMIN LOGS IN
  // ============================================================

  useEffect(() => {
    if (currentUser && isAdmin) {
      fetchEmployees();
    }
  }, [currentUser]);

  // ============================================================
  // LOGIN
  // ============================================================

  const handleLogin = async (e) => {
    e.preventDefault();

    setLoginError('');
    setLoadingAuth(true);

    try {
      const res = await fetch(
        `${API_BASE}/api/auth/login`,
        {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json',
          },

          body: JSON.stringify({
            email: loginEmail,
            password: loginPassword,
          }),
        }
      );

      const data = await res.json();

      if (!res.ok) {
        throw new Error(
          data.message || 'Authentication failed'
        );
      }

      if (!data.user) {
        throw new Error(
          'Login successful but user information was not returned'
        );
      }

      localStorage.setItem(
        'hrms_user',
        JSON.stringify(data.user)
      );

      setCurrentUser(data.user);

      setLoginEmail('');
      setLoginPassword('');
    } catch (error) {
      console.error('Login error:', error);

      setLoginError(
        error.message || 'Unable to sign in'
      );
    } finally {
      setLoadingAuth(false);
    }
  };

  // ============================================================
  // LOGOUT
  // ============================================================

  const handleLogout = () => {
    localStorage.removeItem('hrms_user');

    setCurrentUser(null);
    setEmployees([]);
    setLoginEmail('');
    setLoginPassword('');
    setAttendanceStatus('Checked Out');
    setCheckInTime('--:--');
    setCheckOutTime('--:--');
  };

  // ============================================================
  // CREATE EMPLOYEE
  // ============================================================

  const handleCreateEmployee = async (e) => {
    e.preventDefault();

    setCreatingEmployee(true);

    try {
      const res = await fetch(
        `${API_BASE}/api/admin/employees`,
        {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json',
          },

          body: JSON.stringify(newEmp),
        }
      );

      const data = await res.json();

      if (!res.ok) {
        throw new Error(
          data.message ||
            'Failed to create employee'
        );
      }

      alert(
        data.message ||
          'Employee and login account created successfully'
      );

      setShowModal(false);

      setNewEmp({
        ...DEFAULT_EMPLOYEE,
      });

      await fetchEmployees();
    } catch (error) {
      console.error(
        'Create employee error:',
        error
      );

      alert(
        error.message ||
          'Unable to create employee'
      );
    } finally {
      setCreatingEmployee(false);
    }
  };

  // ============================================================
  // CHECK IN
  // ============================================================

  const handleCheckIn = () => {
    const now = new Date();

    const time = now.toLocaleTimeString([], {
      hour: '2-digit',
      minute: '2-digit',
    });

    setCheckInTime(time);
    setAttendanceStatus('Checked In');
  };

  // ============================================================
  // CHECK OUT
  // ============================================================

  const handleCheckOut = () => {
    const now = new Date();

    const time = now.toLocaleTimeString([], {
      hour: '2-digit',
      minute: '2-digit',
    });

    setCheckOutTime(time);
    setAttendanceStatus('Checked Out');
  };

  // ============================================================
  // UPDATE NEW EMPLOYEE FIELD
  // ============================================================

  const updateNewEmployee = (field, value) => {
    setNewEmp((previous) => ({
      ...previous,
      [field]: value,
    }));
  };

  // ============================================================
  // LOGIN PAGE
  // ============================================================

  if (!currentUser) {
    return (
      <div className="min-vh-100 bg-light d-flex align-items-center justify-content-center p-3">
        <div
          className="card shadow border-0"
          style={{
            width: '100%',
            maxWidth: '450px',
          }}
        >
          <div className="card-body p-4 p-md-5">
            <div className="text-center mb-4">
              <h2 className="fw-bold mb-1">
                Ramel HR Portal
              </h2>

              <p className="text-muted mb-0">
                Sign in to your organization workspace
              </p>
            </div>

            {loginError && (
              <div
                className="alert alert-danger"
                role="alert"
              >
                {loginError}
              </div>
            )}

            <form onSubmit={handleLogin}>
              <div className="mb-3">
                <label
                  htmlFor="loginEmail"
                  className="form-label fw-semibold"
                >
                  Work Email
                </label>

                <input
                  id="loginEmail"
                  type="email"
                  className="form-control"
                  placeholder="name@company.com"
                  value={loginEmail}
                  onChange={(e) =>
                    setLoginEmail(e.target.value)
                  }
                  required
                  autoComplete="email"
                />
              </div>

              <div className="mb-3">
                <label
                  htmlFor="loginPassword"
                  className="form-label fw-semibold"
                >
                  Password
                </label>

                <input
                  id="loginPassword"
                  type="password"
                  className="form-control"
                  placeholder="Enter password"
                  value={loginPassword}
                  onChange={(e) =>
                    setLoginPassword(e.target.value)
                  }
                  required
                  autoComplete="current-password"
                />
              </div>

              <button
                type="submit"
                className="btn btn-primary w-100"
                disabled={loadingAuth}
              >
                {loadingAuth
                  ? 'Signing In...'
                  : 'Sign In'}
              </button>
            </form>

            {/* <div className="alert alert-light border mt-4 mb-0">
              <small className="text-muted">
                <strong>Default Admin</strong>
                <br />
                admin@ramel.co.in
                <br />
                password123
              </small>
            </div> */}
          </div>
        </div>
      </div>
    );
  }

  // ============================================================
  // LOGGED-IN PORTAL
  // ============================================================

  const initials = currentUser.email
    ? currentUser.email
        .slice(0, 2)
        .toUpperCase()
    : 'US';

  return (
    <div className="min-vh-100 bg-light">
      {/* ======================================================
          HEADER
      ====================================================== */}

      <nav className="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div className="container-fluid px-4">
          <span className="navbar-brand fw-bold">
            Ramel HR
          </span>

          <div className="d-flex align-items-center gap-3">
            <div className="text-white text-end d-none d-md-block">
              <div className="fw-semibold">
                {currentUser.tenant?.name ||
                  'Organization'}
              </div>

              <small className="text-white-50">
                {currentUser.role}
              </small>
            </div>

            <div
              className="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold"
              style={{
                width: '40px',
                height: '40px',
              }}
            >
              {initials}
            </div>

            <div className="dropdown">
              <button
                className="btn btn-outline-light btn-sm dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
              >
                Account
              </button>

              <ul className="dropdown-menu dropdown-menu-end">
                <li>
                  <span className="dropdown-item-text">
                    <strong>
                      {currentUser.email}
                    </strong>
                  </span>
                </li>

                <li>
                  <hr className="dropdown-divider" />
                </li>

                <li>
                  <button
                    className="dropdown-item text-danger"
                    onClick={handleLogout}
                  >
                    Logout
                  </button>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </nav>

      {/* ======================================================
          MAIN CONTENT
      ====================================================== */}

      <main className="container-fluid px-4 py-4">
        {/* ====================================================
            ADMIN DASHBOARD
        ==================================================== */}

        {isAdmin ? (
          <>
            <div className="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
              <div>
                <h3 className="fw-bold mb-1">
                  Admin Console
                </h3>

                <p className="text-muted mb-0">
                  Employee Management & Users
                </p>
              </div>

              <button
                className="btn btn-primary"
                onClick={() =>
                  setShowModal(true)
                }
              >
                <i className="bi bi-person-plus me-2"></i>
                Add New Employee
              </button>
            </div>

            {/* Error */}

            {employeeError && (
              <div className="alert alert-danger">
                {employeeError}

                <button
                  className="btn btn-sm btn-outline-danger ms-3"
                  onClick={fetchEmployees}
                >
                  Retry
                </button>
              </div>
            )}

            {/* Employee Records */}

            <div className="card border-0 shadow-sm">
              <div className="card-header bg-white py-3">
                <div className="d-flex justify-content-between align-items-center">
                  <div>
                    <h5 className="mb-0 fw-bold">
                      Employee Records
                    </h5>

                    <small className="text-muted">
                      {employees.length} employee
                      {employees.length !== 1
                        ? 's'
                        : ''}
                    </small>
                  </div>

                  <button
                    className="btn btn-sm btn-outline-secondary"
                    onClick={fetchEmployees}
                    disabled={loadingEmployees}
                  >
                    {loadingEmployees
                      ? 'Loading...'
                      : 'Refresh'}
                  </button>
                </div>
              </div>

              <div className="card-body p-0">
                {loadingEmployees ? (
                  <div className="text-center py-5">
                    <div
                      className="spinner-border text-primary"
                      role="status"
                    ></div>

                    <p className="text-muted mt-3 mb-0">
                      Loading employees...
                    </p>
                  </div>
                ) : employees.length === 0 ? (
                  <div className="text-center py-5 px-3">
                    <div className="fs-1 mb-3">
                      👥
                    </div>

                    <h5>
                      No employees registered yet
                    </h5>

                    <p className="text-muted">
                      Click "Add New Employee" to
                      create an employee and login
                      account.
                    </p>

                    <button
                      className="btn btn-primary"
                      onClick={() =>
                        setShowModal(true)
                      }
                    >
                      Add First Employee
                    </button>
                  </div>
                ) : (
                  <div className="table-responsive">
                    <table className="table table-hover align-middle mb-0">
                      <thead className="table-light">
                        <tr>
                          <th>Employee</th>
                          <th>Code</th>
                          <th>Department & Role</th>
                          <th>Login Email</th>
                          <th>Status</th>
                          <th className="text-end">
                            Action
                          </th>
                        </tr>
                      </thead>

                      <tbody>
                        {employees.map(
                          (emp, index) => {
                            const fullName =
                              emp.full_name ||
                              `${emp.first_name || ''} ${
                                emp.last_name || ''
                              }`.trim() ||
                              'Employee';

                            const employeeInitials =
                              fullName
                                .split(' ')
                                .map(
                                  (name) =>
                                    name[0]
                                )
                                .join('')
                                .slice(0, 2)
                                .toUpperCase();

                            return (
                              <tr
                                key={
                                  emp.id ||
                                  emp.employee_id ||
                                  index
                                }
                              >
                                <td>
                                  <div className="d-flex align-items-center gap-3">
                                    <div
                                      className="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center"
                                      style={{
                                        width:
                                          '42px',
                                        height:
                                          '42px',
                                      }}
                                    >
                                      {
                                        employeeInitials
                                      }
                                    </div>

                                    <div>
                                      <div className="fw-semibold">
                                        {fullName}
                                      </div>

                                      <small className="text-muted">
                                        {emp.designation ||
                                          'Staff'}
                                      </small>
                                    </div>
                                  </div>
                                </td>

                                <td>
                                  {emp.employee_code ||
                                    emp.code ||
                                    '-'}
                                </td>

                                <td>
                                  <div>
                                    {emp.department ||
                                      'General'}
                                  </div>

                                  <small className="text-muted">
                                    {emp.role_name ||
                                      emp.role ||
                                      emp.role_key ||
                                      'Employee'}
                                  </small>
                                </td>

                                <td>
                                  {emp.email || '-'}
                                </td>

                                <td>
                                  <span
                                    className={`badge ${
                                      (
                                        emp.status ||
                                        'Active'
                                      ).toLowerCase() ===
                                      'active'
                                        ? 'text-bg-success'
                                        : 'text-bg-secondary'
                                    }`}
                                  >
                                    {emp.status ||
                                      'Active'}
                                  </span>
                                </td>

                                <td className="text-end">
                                  <button
                                    className="btn btn-sm btn-outline-primary"
                                    onClick={() =>
                                      alert(
                                        `Employee: ${fullName}`
                                      )
                                    }
                                  >
                                    View Profile
                                  </button>
                                </td>
                              </tr>
                            );
                          }
                        )}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            </div>
          </>
        ) : (
          /* ====================================================
             EMPLOYEE SELF-SERVICE DASHBOARD
          ==================================================== */

          <>
            <div className="mb-4">
              <h3 className="fw-bold mb-1">
                Employee Portal
              </h3>

              <p className="text-muted mb-0">
                Welcome back 👋
              </p>

              <small className="text-muted">
                Logged in as:{' '}
                <strong>
                  {currentUser.email}
                </strong>
              </small>
            </div>

            <div className="row g-4">
              {/* Attendance */}

              <div className="col-12 col-lg-5">
                <div className="card border-0 shadow-sm h-100">
                  <div className="card-body p-4">
                    <div className="d-flex justify-content-between align-items-start mb-4">
                      <div>
                        <small className="text-muted fw-semibold">
                          TODAY'S ATTENDANCE
                        </small>

                        <h3 className="fw-bold mt-2 mb-0">
                          {attendanceStatus}
                        </h3>
                      </div>

                      <span
                        className={`badge ${
                          attendanceStatus ===
                          'Checked In'
                            ? 'text-bg-success'
                            : 'text-bg-secondary'
                        }`}
                      >
                        {attendanceStatus}
                      </span>
                    </div>

                    <div className="text-center py-3">
                      <div className="display-5 fw-bold">
                        {checkInTime}
                      </div>

                      <div className="text-muted">
                        Check-in time
                      </div>
                    </div>

                    <div className="d-flex gap-2 mt-3">
                      <button
                        className="btn btn-success flex-fill"
                        onClick={handleCheckIn}
                        disabled={
                          attendanceStatus ===
                          'Checked In'
                        }
                      >
                        Check In
                      </button>

                      <button
                        className="btn btn-outline-danger flex-fill"
                        onClick={handleCheckOut}
                        disabled={
                          attendanceStatus ===
                          'Checked Out'
                        }
                      >
                        Check Out
                      </button>
                    </div>

                    <hr />

                    <div className="row text-center">
                      <div className="col-6">
                        <small className="text-muted">
                          Check In
                        </small>

                        <div className="fw-semibold">
                          {checkInTime}
                        </div>
                      </div>

                      <div className="col-6">
                        <small className="text-muted">
                          Check Out
                        </small>

                        <div className="fw-semibold">
                          {checkOutTime}
                        </div>
                      </div>
                    </div>

                    <div className="mt-4 text-center">
                      <small className="text-muted">
                        Shift: 09:00 - 18:00
                      </small>
                    </div>
                  </div>
                </div>
              </div>

              {/* Weekly Chart */}

              <div className="col-12 col-lg-7">
                <div className="card border-0 shadow-sm h-100">
                  <div className="card-body p-4">
                    <div className="mb-3">
                      <small className="text-muted fw-semibold">
                        WEEKLY ACTIVITY
                      </small>

                      <h5 className="fw-bold mt-2">
                        Hours Worked This Week
                      </h5>
                    </div>

                    <Chart
                      options={chartOptions}
                      series={chartSeries}
                      type="bar"
                      height={320}
                    />
                  </div>
                </div>
              </div>
            </div>
          </>
        )}
      </main>

      {/* ======================================================
          CREATE EMPLOYEE MODAL
      ====================================================== */}

      {showModal && (
        <div
          className="modal d-block"
          tabIndex="-1"
          style={{
            backgroundColor:
              'rgba(0, 0, 0, 0.5)',
          }}
        >
          <div className="modal-dialog modal-dialog-centered modal-lg">
            <div className="modal-content border-0 shadow">
              <div className="modal-header">
                <div>
                  <h5 className="modal-title fw-bold">
                    Create Employee & Login Account
                  </h5>

                  <small className="text-muted">
                    Create an employee profile and
                    login credentials.
                  </small>
                </div>

                <button
                  type="button"
                  className="btn-close"
                  onClick={() =>
                    setShowModal(false)
                  }
                ></button>
              </div>

              <form onSubmit={handleCreateEmployee}>
                <div className="modal-body">
                  <div className="row g-3">
                    {/* First Name */}

                    <div className="col-md-6">
                      <label className="form-label fw-semibold">
                        First Name
                      </label>

                      <input
                        type="text"
                        className="form-control"
                        value={newEmp.firstName}
                        onChange={(e) =>
                          updateNewEmployee(
                            'firstName',
                            e.target.value
                          )
                        }
                        required
                      />
                    </div>

                    {/* Last Name */}

                    <div className="col-md-6">
                      <label className="form-label fw-semibold">
                        Last Name
                      </label>

                      <input
                        type="text"
                        className="form-control"
                        value={newEmp.lastName}
                        onChange={(e) =>
                          updateNewEmployee(
                            'lastName',
                            e.target.value
                          )
                        }
                        required
                      />
                    </div>

                    {/* Email */}

                    <div className="col-md-6">
                      <label className="form-label fw-semibold">
                        Work Email
                      </label>

                      <input
                        type="email"
                        className="form-control"
                        placeholder="employee@ramel.co.in"
                        value={newEmp.email}
                        onChange={(e) =>
                          updateNewEmployee(
                            'email',
                            e.target.value
                          )
                        }
                        required
                      />

                      <small className="text-muted">
                        This email will be used as the
                        login username.
                      </small>
                    </div>

                    {/* Password */}

                    <div className="col-md-6">
                      <label className="form-label fw-semibold">
                        Temporary Password
                      </label>

                      <input
                        type="password"
                        className="form-control"
                        value={newEmp.password}
                        onChange={(e) =>
                          updateNewEmployee(
                            'password',
                            e.target.value
                          )
                        }
                        minLength="6"
                        required
                      />
                    </div>

                    {/* Department */}

                    <div className="col-md-6">
                      <label className="form-label fw-semibold">
                        Department
                      </label>

                      <input
                        type="text"
                        className="form-control"
                        value={newEmp.department}
                        onChange={(e) =>
                          updateNewEmployee(
                            'department',
                            e.target.value
                          )
                        }
                        required
                      />
                    </div>

                    {/* Designation */}

                    <div className="col-md-6">
                      <label className="form-label fw-semibold">
                        Designation
                      </label>

                      <input
                        type="text"
                        className="form-control"
                        value={newEmp.designation}
                        onChange={(e) =>
                          updateNewEmployee(
                            'designation',
                            e.target.value
                          )
                        }
                        required
                      />
                    </div>

                    {/* System Role */}

                    <div className="col-12">
                      <label className="form-label fw-semibold">
                        System Role
                      </label>

                      <select
                        className="form-select"
                        value={newEmp.roleKey}
                        onChange={(e) =>
                          updateNewEmployee(
                            'roleKey',
                            e.target.value
                          )
                        }
                      >
                        <option value="SOFTWARE_ENGINEER">
                          Software Engineer
                        </option>

                        <option value="HR">
                          HR
                        </option>

                        <option value="MANAGER">
                          Manager
                        </option>

                        <option value="TEAM_LEAD">
                          Team Lead
                        </option>

                        <option value="EMPLOYEE">
                          Employee
                        </option>
                      </select>
                    </div>
                  </div>
                </div>

                <div className="modal-footer">
                  <button
                    type="button"
                    className="btn btn-secondary"
                    onClick={() =>
                      setShowModal(false)
                    }
                    disabled={creatingEmployee}
                  >
                    Cancel
                  </button>

                  <button
                    type="submit"
                    className="btn btn-primary"
                    disabled={creatingEmployee}
                  >
                    {creatingEmployee
                      ? 'Creating...'
                      : 'Create User & Employee'}
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
